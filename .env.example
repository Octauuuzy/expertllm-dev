APP_NAME=ExpertLLM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# HMAC secret for API bearer tokens (falls back to APP_KEY when unset).
# Generate with: php artisan key:generate --show
JWT_SECRET=

# AI providers (server-side only; never shipped to the browser)
VERTEX_PROJECT_ID=
VERTEX_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
USE_METADATA_SERVER=false
OPENROUTER_API_KEY=
CHUTES_API_KEY=

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# When set, Gemini models use it and Vertex is not needed. Gemini 4 Argon is paid-tier only.
GEMINI_API_KEY=

# Web search. Pick one provider and set its key (or leave SEARCH_PROVIDER blank and
# the first provider with a key is used).
#   serper  - Google results, 2,500 free queries, no card: https://serper.dev
#   tavily  - 1,000 free credits per month, no card:        https://tavily.com
#   brave   - $5 monthly credit, card required:             https://brave.com/search/api
SEARCH_PROVIDER=
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Legacy Google Programmable Search (closed to new customers). Optional.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_KEYS=

VITE_APP_NAME="${APP_NAME}"
